#SERVER
PORT=3000
DEV=true

# Абсолютный адрес магазина без хвоста (canonical, og:image, sitemap).
# Пример: https://shop.example.com
PUBLIC_SITE_URL=

#UPLOAD
# При запуске в docker перебивается на /app/uploads (том с картинками) — см. compose.yml.
UPLOAD_PATH=./images

#DOCKER — эти две переменные читает сам docker compose (подстановка ${...}),
# поэтому они должны лежать в окружении оболочки или в корневом .env, а не здесь:
# VITE_API_URL — адрес API, который вшивается в бандл клиента на сборке образа
#                (в проде — домен магазина, тот же, что WEBAPP_URL);
# APP_PORT     — порт магазина на хосте (внутри контейнера всегда 3000).

#TELEGRAM
BOT_TOKEN=
# https-адрес сайта для Mini App (в dev — туннель). Пусто — бот без кнопок магазина.
WEBAPP_URL=
# Telegram-id админов через запятую — им доступны кнопка «Панель управления» и /admin.
ADMIN_TELEGRAM_IDS=
# Секрет подписи куки сессии админки (пусто — используется BOT_TOKEN).
ADMIN_JWT_SECRET=
# Только для локальной разработки: снимает проверку прав с мутирующих эндпоинтов.
ADMIN_AUTH_DISABLED=

#CORS — домены фронта через запятую (по умолчанию http://localhost:5173)
CORS_ORIGINS=

#CDEK (доставка: виджет ПВЗ на странице корзины)
# Аккаунт и пароль интеграции из личного кабинета СДЭК (не логин от ЛК).
# Пусто — виджет не показывается, покупатель вводит адрес руками.
CDEK_ACCOUNT=
CDEK_SECURE_PASSWORD=
# Боевой контур; тестовый (креды из документации СДЭК) — https://api.edu.cdek.ru/v2
CDEK_API_URL=https://api.cdek.ru/v2
# Ключ JavaScript API Яндекс.Карт — на них виджет рисует карту ПВЗ.
CDEK_YANDEX_MAPS_API_KEY=
# Город, из которого уходят посылки, и его код в справочнике СДЭК: тарифы
# считаются по коду (по названию калькулятор отвечает 400). Найти код:
# GET /cdek/service?action=cities&country_codes=RU&city=<название>
CDEK_FROM_CITY=
CDEK_FROM_CITY_CODE=
# Город, который виджет показывает на карте до выбора покупателя.
CDEK_DEFAULT_CITY=
# Какие тарифы показывать покупателю (коды через запятую). Пусто — набор
# виджета по умолчанию. Посмотреть доступные на своём направлении можно расчётом
# через /cdek/service (action=calculate).
CDEK_TARIFFS_OFFICE=
CDEK_TARIFFS_DOOR=
# false — курьерскую доставку до двери не предлагаем вовсе, только пункты выдачи.
CDEK_DOOR_DELIVERY=true
# Как назвать тарифы покупателю: код:название через запятую. Пусто — названия СДЭК.
CDEK_TARIFF_NAMES=
# Коробка по умолчанию: габариты в см, вес в граммах. Берётся для товаров,
# у которых свои вес и габариты не заполнены (поля есть в карточке товара).
CDEK_PARCEL_LENGTH=20
CDEK_PARCEL_WIDTH=15
CDEK_PARCEL_HEIGHT=10
CDEK_PARCEL_WEIGHT=500

#PostgreSQL — внутри compose хост = имя сервиса postgres
DATABASE_URL=postgres://fairytale:change_me@postgres:5432/fairytale
# Порт Postgres на хосте (для server/.env и drizzle-kit migrate с машины разработчика)
POSTGRES_PORT=15432
POSTGRES_USER=fairytale
POSTGRES_PASSWORD=change_me
POSTGRES_DB=fairytale
