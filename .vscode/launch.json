  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Run Server",
      "runtimeExecutable": "bun",
      "cwd": "${workspaceFolder}/server",
      "runtimeArgs": ["run", "dev"],
      "console": "integratedTerminal",
      "stopOnEntry": true
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Run Client",
      "runtimeExecutable": "bun",
      "cwd": "${workspaceFolder}/client",
      "runtimeArgs": ["run", "dev"],
      "console": "integratedTerminal"
    }
  ]
}
