#SERVER
PORT=3000
DEV=true

# Абсолютный адрес магазина без хвоста (canonical, og:image, sitemap).
# Пример: https://shop.example.com
PUBLIC_SITE_URL=

#UPLOAD
UPLOAD_PATH=./test_uploads

#TELEGRAM
BOT_TOKEN=
# URL сайта, который бот открывает как Mini App (кнопка «Открыть магазин» и меню-кнопка).
# Обязательно https (Telegram не откроет http/localhost). В dev — туннель (ngrok/cloudflared),
# в проде — адрес сайта. Если пусто — бот работает, но без кнопки магазина.
WEBAPP_URL=
# Telegram-id админов через запятую — им бот показывает кнопку «Панель управления»
# (открывает WEBAPP_URL/admin) и команду /admin. Свой id: напишите @userinfobot.
# Альтернатива — вручную выставить users.is_admin = true в БД.
ADMIN_TELEGRAM_IDS=
# Секрет для подписи куки сессии админки. Если пусто — берётся BOT_TOKEN
# (при его перевыпуске сессии просто разлогинятся).
ADMIN_JWT_SECRET=
# ТОЛЬКО для локальной разработки: отключает проверку прав на мутирующих
# эндпоинтах (в браузере вне Телеграма initData взять негде). В проде не ставить.
ADMIN_AUTH_DISABLED=

#CORS
# Домены фронта через запятую (нужен точный список: куки ходят с credentials).
# По умолчанию http://localhost:5173
CORS_ORIGINS=

#MAIL (SMTP — уведомление владелице о новом заказе)
# Yandex: smtp.yandex.ru:465 (secure=true), пароль приложения.
# Mail.ru: smtp.mail.ru:465 (secure=true), пароль для внешних приложений.
# Если переменные не заданы — письмо не отправляется (заказ всё равно создаётся).
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MAIL_TO=

#CDEK (доставка: виджет ПВЗ на странице корзины)
# Аккаунт и пароль интеграции из личного кабинета СДЭК — это не логин и пароль
# от ЛК, а отдельная пара ключей (выдаётся после договора). Для разработки
# подойдут тестовые креды из документации СДЭК вместе с тестовым CDEK_API_URL.
# Если не заданы — виджет на витрине не показывается, /cdek/service отвечает 503,
# покупатель вводит адрес доставки руками (как было до интеграции).
CDEK_ACCOUNT=
CDEK_SECURE_PASSWORD=
# Боевой контур; тестовый — https://api.edu.cdek.ru/v2
CDEK_API_URL=https://api.cdek.ru/v2
# Ключ JavaScript API Яндекс.Карт (кабинет разработчика Яндекса): на них виджет
# рисует карту ПВЗ. Ключ уходит в браузер — ограничьте его доменом магазина.
CDEK_YANDEX_MAPS_API_KEY=
# Город-отправитель и его код в справочнике СДЭК. Нужен именно код: калькулятор
# не резолвит from_location по названию и отвечает 400, так что без кода виджет
# не включается. Найти код (сервер должен быть запущен):
#   curl "http://localhost:3000/cdek/service?action=cities&country_codes=RU&city=Красноярск"
CDEK_FROM_CITY=
CDEK_FROM_CITY_CODE=
# Город, который виджет показывает на карте до выбора покупателя
# (по умолчанию — город-отправитель).
CDEK_DEFAULT_CITY=
# Какие тарифы показывать покупателю — коды через запятую, отдельно для выдачи
# в ПВЗ и для курьера. Пусто — набор виджета по умолчанию (там есть заведомо
# лишнее вроде «Сборного груза»). Первое слово в названии тарифа — что делает
# магазин: «склад-...» — посылку сдают в офис СДЭК, «дверь-...» — забирает курьер.
# Доступные на своём направлении смотреть расчётом (action=calculate).
CDEK_TARIFFS_OFFICE=
CDEK_TARIFFS_DOOR=
# false — не предлагать курьерскую доставку до двери. Если оставить включённой,
# витрина дополнительно спрашивает квартиру: виджет отдаёт адрес только до дома.
CDEK_DOOR_DELIVERY=true
# Как назвать тарифы покупателю (код:название через запятую). Служебные имена
# СДЭК вроде «Посылка склад-склад» в витрине только путают.
# Пример: 136:Обычная,483:Экспресс,137:Обычная,482:Экспресс
CDEK_TARIFF_NAMES=
# Коробка по умолчанию: габариты в см, вес в граммах. Используется для товаров,
# у которых вес и габариты не заполнены в карточке. Посылка на заказ собирается
# из состава корзины (client/src/scripts/parcel.ts): вес и объём складываются.
CDEK_PARCEL_LENGTH=20
CDEK_PARCEL_WIDTH=15
CDEK_PARCEL_HEIGHT=10
CDEK_PARCEL_WEIGHT=500

# Оплата — Робокасса. Все три значения заданы → оплата включена: заказ сразу
# ведёт на платёжную страницу. Не заданы → заказы без онлайн-оплаты, как раньше.
# В технических настройках магазина в ЛК Робокассы:
#   Result URL  — <адрес API>/payments/robokassa/result  (метод POST)
#   Success URL — <адрес API>/payments/robokassa/success (метод GET)
#   Fail URL    — <адрес API>/payments/robokassa/fail    (метод GET)
ROBOKASSA_MERCHANT_LOGIN=
# Пароли №1 и №2 из ЛК. В тестовом режиме — тестовые пароли, они другие.
ROBOKASSA_PASSWORD1=
ROBOKASSA_PASSWORD2=
# true — тестовые платежи (IsTest=1, деньги не списываются). false — после активации магазина.
ROBOKASSA_TEST=true
# Алгоритм подписи — как выбран в ЛК: md5 | sha1 | sha256 | sha384 | sha512
ROBOKASSA_HASH=md5
# true — передавать состав заказа для чека («Робочеки СМЗ» для самозанятых)
ROBOKASSA_RECEIPT=false
# Ставка НДС в чеке (у самозанятых — none)
ROBOKASSA_TAX=none
# Сколько минут неоплаченный заказ держит товар; потом отменяется, остаток возвращается
PAYMENT_TTL_MINUTES=60

#PostgreSQL
# С хоста (миграции, bun dev): localhost и порт из compose (по умолчанию 15432).
# Внутри docker-compose: host=postgres, порт 5432 — см. корневой .env.development.
DATABASE_URL=postgres://USER:PASSWORD@localhost:15432/fairytale
POSTGRES_USER=fairytale
POSTGRES_PASSWORD=change_me
POSTGRES_DB=fairytale
